# Copy to .env.local and fill in what applies. Every value is optional.

# Public address of the live site, no trailing slash. Enables canonical URLs,
# absolute Open Graph image URLs and sitemap.xml. Leave empty until the domain is decided.
VITE_SITE_URL=

# Base URL of a future content API (headless CMS, project API). When empty, the
# site reads its content from the typed files in src/data.
VITE_API_BASE_URL=

# Endpoint that accepts the contact form as a JSON POST. When empty, the form
# opens the visitor's email app addressed to siteConfig.contact.email.
VITE_CONTACT_ENDPOINT=
