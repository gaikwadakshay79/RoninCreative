# Copy to .env.local and fill in what applies. Every value is optional.

# Public address of the live site, no trailing slash, including any sub-folder
# (https://example.com or https://user.github.io/RoninCreative). Enables
# canonical URLs, absolute Open Graph image URLs and sitemap.xml. Leave empty
# until the address is decided.
VITE_SITE_URL=

# Folder the site is served from. Leave empty for the root of a domain. A
# GitHub Pages project site needs its repository name, for example
# /RoninCreative/. The deploy workflow sets this by itself.
VITE_BASE_PATH=

# Base URL of a future content API (headless CMS, project API). When empty, the
# site reads its content from the typed files in src/data.
VITE_API_BASE_URL=

# Endpoint that accepts the contact form as a JSON POST. When empty, the form
# opens the visitor's email app addressed to siteConfig.contact.email.
VITE_CONTACT_ENDPOINT=
